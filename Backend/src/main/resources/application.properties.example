spring.application.name=Backend


#CONNECT TO MYSQL DATABASE
spring.sql.init.platform=mysql
server.port=5050
spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
#CREATE DATABASE IF NOT EXIST
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/inventory_db?createDatabaseIfNotExist=true}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:dorecefa}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
#spring.jpa.show-sql: true

secreteJwtString=${JWT_SECRET:mySecretKeymySecretKeymySecretKeymySecretKeymySecretKeymySecretKeymySecretKeymySecretKey}

#THE MAXIMUM SIZE OF IMAGE THAT CAN BE UPLOADED
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Uploaded files are stored outside the frontend build and served from /uploads/**
app.upload.directory=${APP_UPLOAD_DIRECTORY:uploads}

# CORS — comma-separated origins; override with CORS_ALLOWED_ORIGINS env var in production
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000}
cors.max-age-seconds=${CORS_MAX_AGE_SECONDS:3600}
