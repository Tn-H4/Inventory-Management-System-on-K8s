# ==============================================================================
# TEMPLATE / EXAMPLE SECRETS FOR KUBERNETES DEPLOYMENT
# ==============================================================================
# Instructions:
# 1. Copy this file to: 01-secrets.yaml
# 2. Replace the placeholder values with your strong, secure passwords/secrets.
# 3. Apply to cluster: kubectl apply -f 01-secrets.yaml
# 4. NEVER commit the actual 01-secrets.yaml containing real passwords to GitHub!
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: ims
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "YOUR_MYSQL_ROOT_PASSWORD_HERE"
  MYSQL_DATABASE: "inventory_db"
  MYSQL_USER: "ims_user"
  MYSQL_PASSWORD: "YOUR_MYSQL_USER_PASSWORD_HERE"
---
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: ims
type: Opaque
stringData:
  DB_URL: "jdbc:mysql://mysql:3306/inventory_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false"
  DB_USERNAME: "root"
  DB_PASSWORD: "YOUR_MYSQL_ROOT_PASSWORD_HERE"
  JWT_SECRET: "YOUR_STRONG_HEX_OR_BASE64_JWT_SECRET_KEY_MIN_32_BYTES_LONG"

